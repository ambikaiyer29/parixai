# ─────────────────────────────────────────────────────────────────────────────
# parixai cloud — environment variables
#
# Copy this file to .env.local and fill in the values.
# Never commit .env.local to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (required for dashboard / core app) ─────────────────────────────

# Your Supabase project URL (e.g. https://xxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon / public key (safe to expose in browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key — keep secret, server-side only
SUPABASE_SERVICE_ROLE_KEY=

# ── Database ─────────────────────────────────────────────────────────────────

# Postgres connection string (Supabase → Settings → Database → Connection string)
# Use the "Session mode" URL for long-lived server connections.
DATABASE_URL=

# ── Internal ─────────────────────────────────────────────────────────────────

# Secret used for internal API-to-API calls (generate with: openssl rand -hex 32)
INTERNAL_SECRET=
